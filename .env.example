# Docker Compose values. The server address is configured; add the password you create.
MYSQL_URL='jdbc:mysql://218.156.22.171:9001/ai_decision_map?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&sslMode=PREFERRED&connectTimeout=5000&socketTimeout=10000'
MYSQL_USERNAME=decision_map_app
MYSQL_PASSWORD=replace-with-the-password-from-docs/mysql-bootstrap.sql

# Browser-visible API origin. Use an empty value when Nginx proxies /api on the same domain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8013

# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3007

# Create a key at https://platform.openai.com/api-keys and configure API billing separately.
# Server-only OpenAI Responses API configuration. Never expose this key with NEXT_PUBLIC_.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-openai-api-key
LLM_CONVERSATION_MODEL=gpt-5.6-luna
LLM_NARRATIVE_MODEL=gpt-5.6-terra
LLM_CONVERSATION_REASONING_EFFORT=none
LLM_NARRATIVE_REASONING_EFFORT=low
LLM_PROMPT_VERSION=decision-coach-v4
LLM_CONVERSATION_MAX_OUTPUT_TOKENS=3500
LLM_NARRATIVE_MAX_OUTPUT_TOKENS=3500
