# 서버에서 이 파일을 config/app.env로 복사한 뒤 실제 값으로 변경하세요.
# config/app.env는 Git에 포함되지 않습니다.
MYSQL_URL='jdbc:mysql://218.156.22.171:9001/ai_decision_map?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&sslMode=PREFERRED&connectTimeout=5000&socketTimeout=10000'
MYSQL_USERNAME=decision_map_app
MYSQL_PASSWORD=replace-with-a-strong-password

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-openai-api-key
LLM_CONVERSATION_MODEL=gpt-5.6-luna
LLM_NARRATIVE_MODEL=gpt-5.6-terra
LLM_CONVERSATION_REASONING_EFFORT=none
LLM_NARRATIVE_REASONING_EFFORT=low
LLM_PROMPT_VERSION=decision-coach-v4
LLM_CONVERSATION_MAX_OUTPUT_TOKENS=3500
LLM_NARRATIVE_MAX_OUTPUT_TOKENS=3500

# 실제 서비스 도메인으로 변경하세요. 예: https://decision.example.com
CORS_ALLOWED_ORIGINS=https://decision.example.com

# 비워두면 브라우저가 같은 도메인의 /api를 사용합니다.
NEXT_PUBLIC_API_BASE_URL=
